# Copy to .env.local for `vercel dev`. In production these are set in the
# Vercel project's Environment Variables, never committed.

# Gemini API key for the dashboard insights panel — https://aistudio.google.com/apikey
# Without it the insights panel stays hidden and the rest of the app is unaffected.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.8-flash; gemini-3.5-flash-lite is cheaper.
GEMINI_MODEL=

# --- Morning summary notifications ---------------------------------------
# Generate a pair with:  node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public half is handed to the browser by /api/push; the private half
# never leaves the server. Changing them invalidates every device already
# subscribed, so generate once and keep them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who the push services should contact about this application server.
VAPID_SUBJECT=mailto:you@example.com

# Shared with the Apps Script (Project Settings -> Script Properties ->
# PUSH_SECRET). It gates the one read that returns the list of subscribed
# devices. Any long random string; both sides must match.
PUSH_SECRET=

# Vercel signs cron requests with this. Without it /api/notify refuses the
# scheduled send rather than standing open to anyone who finds the URL.
CRON_SECRET=

# --- Dashboard PIN ----------------------------------------------------------
# The PIN typed after long-pressing the title on the home screen. Checked on
# the server (api/_pin.js), never shipped in the bundle. Optional: unset, it is
# the PIN the app has always used.
ADMIN_PIN=
